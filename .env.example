# ================= CampusConnect Backend — template (copy to .env) =================
# Supabase project: <your-project-ref> (region: <up-to-you>)

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_REST_BASE=https://<your-project-ref>.supabase.co/rest/v1/
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_ANON_KEY=<legacy-anon-jwt>
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=<legacy-service-role-jwt>

# Secret used to sign CampusConnect's own session JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Deployment / CORS
NODE_ENV=production
# Your deployed React app origin (Render calls this on boot for CORS):
FRONTEND_URL=https://your-frontend.vercel.app

# Direct Postgres connection (server-only, for migrations & maintenance)
DB_PASSWORD=your-database-password
